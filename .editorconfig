# Line endings are LF everywhere. Go tooling treats a CRLF file as unformatted,
# and the shell scripts devtree installs have to run on Linux runners.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2

# Generated by `devtree render` and `go run ./internal/art`. Nothing here is
# edited by hand, and reformatting it would only show up as a false diff.
[docs/assets/*.svg]
trim_trailing_whitespace = false
insert_final_newline = false
